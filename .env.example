# Kopirajte u .env.local i popunite vrednostima iz Supabase projekta (Project Settings → API).
# Ove dve vrednosti su javne i smeju u pregledač.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Tajni ključ baze: samo na serveru, upisuje se u Vercel podešavanja, nikad u kod
SUPABASE_SECRET_KEY=
